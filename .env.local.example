# Copy to .env.local (gitignored). Used only by scripts/record_nio_fixtures.py.
# Output: tests/fixtures/nio/recorded/ (also gitignored; tokens sanitized on write).
#
#   uv run python scripts/record_nio_fixtures.py --full-sync
#   uv run python scripts/record_nio_fixtures.py
#   uv run pytest -m recorded -n 0
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USER=@your-test-user:matrix.org
MATRIX_PASSWORD=your-password-here
