/* Global styles for the telemente app. */

#placeholder {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

/* -------------------------------------------------------------------------
   Main screen — three-panel layout (plan 0005)
   ------------------------------------------------------------------------- */

#main-layout {
    height: 1fr;
}

#rooms-panel {
    width: 30;
    border: solid $primary;
    border-title-color: $text;
}

#message-panel {
    width: 1fr;
    border: solid $primary;
    border-title-color: $text;
}

#members-panel {
    width: 24;
    border: solid $primary;
    border-title-color: $text;
}

/* Collapse helper — apply/remove via widget.add_class / remove_class */
.collapsed {
    display: none;
}

/* -------------------------------------------------------------------------
   Room list panel — RoomList widget (plan 0006)
   ------------------------------------------------------------------------- */

RoomList {
    height: 1fr;
    layout: vertical;
}

RoomList #room-search {
    height: 3;
    dock: top;
}

RoomList #room-list-view {
    height: 1fr;
}

RoomList .room-empty-state {
    color: $text-muted;
    text-align: center;
    padding: 1;
}

RoomList .room-name {
    width: 1fr;
}

RoomList .room-unread-badge {
    color: $accent;
    text-style: bold;
}
