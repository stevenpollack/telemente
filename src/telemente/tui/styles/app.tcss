/* Global styles for the telemente app. */

#placeholder {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

/* -------------------------------------------------------------------------
   Main screen — three-panel layout (plan 0005)
   ------------------------------------------------------------------------- */

#main-layout {
    height: 1fr;
}

#rooms-panel {
    width: 30;
    border: solid $primary;
    border-title-color: $text;
}

#message-panel {
    width: 1fr;
    border: solid $primary;
    border-title-color: $text;
}

#message-panel > TabbedContent {
    height: 1fr;
}

#message-panel ContentSwitcher {
    height: 1fr;
}

#message-panel TabPane {
    height: 1fr;
    padding: 0;
}

#members-panel {
    width: 24;
    border: solid $primary;
    border-title-color: $text;
}

/* Collapse helper — apply/remove via widget.add_class / remove_class */
.collapsed {
    display: none;
}

/* -------------------------------------------------------------------------
   Room list panel — RoomList widget (plan 0006)
   ------------------------------------------------------------------------- */

RoomList {
    height: 1fr;
    layout: vertical;
}

RoomList #search-bar {
    height: 3;
    dock: top;
}

RoomList #room-search {
    width: 1fr;
}

RoomList #clear-search {
    width: 3;
    min-width: 3;
    border: none;
    padding: 0;
}

RoomList #room-list-view {
    height: 1fr;
}

RoomList .room-loading-state {
    color: $text-muted;
    text-align: center;
    padding: 1;
}

RoomList .room-empty-state {
    color: $text-muted;
    text-align: center;
    padding: 1;
}

RoomList #room-list-view > .option-list--option {
    padding: 0 1;
}

/* -------------------------------------------------------------------------
   Message view panel — MessageView widget (plan 0007)
   ------------------------------------------------------------------------- */

MessageView {
    height: 1fr;
    layout: vertical;
}

MessageView #message-timeline {
    height: 1fr;
}

MessageView .encryption-notice {
    height: auto;
    padding: 1 2;
    color: $warning;
    text-align: center;
}

MessageView #composer {
    height: 3;
    dock: bottom;
}

_DateSeparator {
    color: $text-muted;
}

_MessageRow {
    height: auto;
    color: $text;
    text-wrap: wrap;
}

/* -------------------------------------------------------------------------
   Member list panel — MemberList widget (plan 0008)
   ------------------------------------------------------------------------- */

MemberList {
    height: 1fr;
    layout: vertical;
}

MemberList #member-list-header {
    height: 1;
    padding: 0 1;
    text-style: bold;
    color: $text;
    dock: top;
}

MemberList #member-list-scroll {
    height: 1fr;
}

MemberList .member-entry {
    height: auto;
    padding: 0 1;
    color: $text;
}

/* -------------------------------------------------------------------------
   Log viewer panel — LogPanel widget (plan 0014)
   ------------------------------------------------------------------------- */

#log-panel {
    display: none;
}

/* -------------------------------------------------------------------------
   Redacted message tombstone — plan 0022
   ------------------------------------------------------------------------- */

MessageRow.-redacted {
    color: $text-disabled;
    text-style: italic;
}

/* -------------------------------------------------------------------------
   In-room message search — search bar and match highlights (plan 0024)
   ------------------------------------------------------------------------- */

MessageView #search-bar {
    display: none;
    height: 1;
}

MessageRow.-search-match {
    border: tall $accent;
}

MessageRow.-search-current {
    background: $accent;
}

/* -------------------------------------------------------------------------
   Context menu — floating widget (plan 0020)
   ------------------------------------------------------------------------- */

/* Declare the layer so ContextMenu's 'layer: context-menu' rule takes effect
   and the menu renders above all panels (Bug 1 fix). */
MainScreen {
    layers: context-menu;
}

ContextMenu {
    width: auto;
    height: auto;
    min-width: 24;
    background: $surface;
    border: round $primary;
    padding: 0 1;
    layer: context-menu;
}

/* Bug 7 fix: width: auto (not 1fr) so menu shrinks to fit content width */
ContextMenu .menu-item {
    height: 1;
    padding: 0 1;
    width: auto;
}

ContextMenu .menu-item:hover,
ContextMenu .menu-item.-focused {
    background: $accent 30%;
}

ContextMenu .menu-item.-disabled {
    color: $text-muted;
}

ContextMenu Rule {
    height: 1;
    color: $primary;
}
